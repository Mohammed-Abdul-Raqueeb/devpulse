{
  "name": "DevPulse",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sqlite:1": {}
  },
  "forwardPorts": [4000, 5173],
  "portsAttributes": {
    "4000": { "label": "API", "onAutoForward": "notify" },
    "5173": { "label": "Dashboard", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": ".devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "qwtel.sqlite-viewer"
      ]
    }
  },
  "remoteUser": "node"
}
