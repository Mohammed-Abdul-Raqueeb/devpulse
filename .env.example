# Copy to .env and fill in. The API validates this at startup and refuses to
# boot on a bad value rather than failing later as a 500.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite file. The parent directory is created if it does not exist.
DATABASE_PATH=./data/devpulse.db

# REQUIRED, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Dashboard origins only. Ingestion accepts any origin by design and is
# authorised by the write key plus each project's allow-list instead.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# Set false on every replica but one.
ENABLE_JOBS=true

# Set true when running behind a reverse proxy, or IP-based rate limiting
# collapses into one global bucket.
TRUST_PROXY=false
