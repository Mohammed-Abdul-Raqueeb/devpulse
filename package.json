{
  "name": "devpulse",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted product analytics: event ingestion API, aggregation engine and dashboard.",
  "author": "Mohammed Abdul Raqueeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohammed-Abdul-Raqueeb/devpulse.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/shared",
    "packages/sdk",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspace=@devpulse/shared && npm run build --workspace=@devpulse/sdk && npm run build --workspace=@devpulse/api && npm run build --workspace=@devpulse/web",
    "dev": "npm run dev --workspace=@devpulse/api & npm run dev --workspace=@devpulse/web",
    "dev:api": "npm run dev --workspace=@devpulse/api",
    "dev:web": "npm run dev --workspace=@devpulse/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force",
    "seed": "node --import tsx packages/api/src/db/seed.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
